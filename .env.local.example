# KBK AgroStore — Environment Variables
# Salin file ini ke .env.local dan isi nilainya

# Nomor WhatsApp pemilik toko (tanpa + dan tanpa spasi, mulai dari 62)
# Contoh: 6281234567890 untuk nomor 0812-3456-7890
NEXT_PUBLIC_WA_NUMBER=628XXXXXXXXXX

# Nomor WA untuk ditampilkan di UI (format bebas, untuk tampilan saja)
NEXT_PUBLIC_WA_DISPLAY=0812-XXXX-XXXX

# (Opsional) URL toko Shopee setelah listing live
NEXT_PUBLIC_SHOPEE_URL=https://shopee.co.id/kbk_agrostore
